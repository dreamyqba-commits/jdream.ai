# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Cloudflare R2 ─────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=zopc-media
R2_PUBLIC_URL=https://media.jdream.ai

# ── Creem.io (primary billing) ───────────────────────────────
CREEM_API_KEY=your-creem-api-key
CREEM_WEBHOOK_SECRET=your-creem-webhook-secret
# Product IDs from Creem dashboard (one ID per plan, matches webhook planMap)
CREEM_PRODUCT_LITE=prod_xxx
CREEM_PRODUCT_PRO=prod_xxx
CREEM_PRODUCT_PREMIUM=prod_xxx

# ── DodoPayments (backup billing) ────────────────────────────
DODO_API_KEY=your-dodo-api-key
DODO_WEBHOOK_SECRET=your-dodo-webhook-secret

# ── Active billing provider: "creem" or "dodo" ───────────────
BILLING_PRIMARY=creem

# ── Model API providers ───────────────────────────────────────
PIAPI_API_KEY=your-piapi-key
FAL_API_KEY=your-fal-key

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://jdream.ai
NEXT_PUBLIC_APP_NAME=Jdream.ai
CRON_SECRET=your-random-cron-secret
